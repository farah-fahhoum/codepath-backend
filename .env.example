# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3000

# Database Configuration (Docker PostgreSQL - for local development)
DATABASE_URL="postgresql://codepath-admin:123qweAsd@localhost:5432/codepath"

# Database Configuration For Production (Neon Tech)
# DATABASE_URL="postgresql://username:password@your-host.com/database?sslmode=require"

# JWT Configuration (Generate a secure secret for production)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# FastAPI Configuration
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Cal.com Webhook (shared secret for HMAC signature verification)
# Set the same value as the CAL_WEBHOOK_SECRET you configure in Cal.com:
# Webhooks -> Event triggers -> Endpoint URL -> http://<your-host>:3000/coaches/webhook/cal
CAL_WEBHOOK_SECRET=your-cal-webhook-secret

# File Upload Configuration
MAX_FILE_SIZE=20971520

# Email (SMTP via Gmail)
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_APP_PASSWORD=your-google-app-password

# Puppeteer (optional)
# If Puppeteer can't find a browser, set a system Chrome path:
# macOS:
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome
# Linux:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# Windows:
# PUPPETEER_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# Persist browser downloads across runs:
# PUPPETEER_CACHE_DIR=.puppeteer-cache
