{
  "name": "codepath-backend",
  "description": "CodePath - AI powered competitive programming platform",
  "main": "dist/src/app.js",
  "type": "commonjs",
  "scripts": {
    "start:js": "node dist/src/app.js",
    "start:ts": "tsx src/app.ts",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f pg",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push",
    "setup:dev": "npm run docker:up && npm run db:generate && npm run db:migrate"
  },
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "pg": "^8.11.3",
    "puppeteer": "^24.31.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@prisma/config": "^7.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/nodemailer": "^7.0.3",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.16.0",
    "nodemon": "^3.1.10",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2"
  }
}
