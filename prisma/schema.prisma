generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model role {
  id Int @id @default(autoincrement())
  title String @unique
  users User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())
  username String @unique
  email String @unique
  password String
  role role @relation(fields: [roleId], references: [id])
  roleId Int
  profile Profile?
  favouriteProblems FavouriteProblem[]
  userProblemAttempts UserProblemAttempt[]
  userSkillAssessments UserSkillAssessment[]
  skillSnapshot UserSkillSnapshot?
  learningProgresses UserLearningProgress[]
  userAchievements UserAchievement[]
  ownedLearningPaths LearningPath[]
  coachProfile Coach?
  menteeBookings Booking[] @relation("MenteeBookings")
  contestsCreated Contest[]
  contestParticipations ContestParticipant[]
  solutionSnippets SolutionSnippet[]
  codePathProblemsCreated CodePathProblem[]
  codePathSubmissions CodePathSubmission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id String @id @default(cuid())
  fullName String
  phone String?
  country String
  city String?
  organization String?
  bio String?
  avatarUrl String?
  rating Int?
  problemsSolved Int?
  accuracy Int?
  user User @relation(fields: [userId], references: [id])
  userId String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExternalAccount {
  id Int @id @default(autoincrement())
  userId String
  platform String
  handle String
  lastSynced DateTime?
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform])
}

model ContactInfo {
  id Int @id @default(autoincrement())
  email String
  phone String
  facebook String?
  instagram String?
  youtube String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInquery {
  id Int @id @default(autoincrement())
  fullName String
  email String
  title String
  message String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizQuestion {
  id Int @id @default(autoincrement())
  questionTitle String
  score Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  options QuizOption[]
}

model QuizOption {
  id Int @id @default(autoincrement())
  questionId Int
  optionText String
  orderIndex Int
  isCorrect Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model FavouriteProblem {
  id String @id @default(cuid())
  userId String
  externalProblemId String
  platform String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  @@unique([userId, externalProblemId, platform])
}

model UserProblemAttempt {
  id String @id @default(cuid())
  userId String
  externalProblemId String
  platform String
  source String @default("external_sync")
  solved Boolean @default(false)
  attemptCount Int @default(0)
  bestExecutionTime Int?
  lastAttempt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  @@unique([userId, externalProblemId, platform])
}

model ExternalSubmission {
  id String @id @default(cuid())
  externalAccountId String
  externalSubmissionId String
  problemId String
  submissionTime Int
  verdict String
  executionTime Int?
  memoryUsed Int?
  programmingLanguage String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model SkillLevel {
  id Int @id @default(autoincrement())
  title String
  description String
  targetRatingRange String
  expectedKnowledge String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assessments UserSkillAssessment[]
  skillSnapshots UserSkillSnapshot[]
  learningPaths LearningPath[]
}

model UserSkillAssessment {
  id Int @id @default(autoincrement())
  userId String
  assessmentType String
  score Int
  skillLevelId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  skillLevel SkillLevel @relation(fields: [skillLevelId], references: [id])
  @@unique([userId, assessmentType, skillLevelId])
}

model UserSkillSnapshot {
  id String @id @default(cuid())
  userId String @unique
  tier String
  rating Int?
  confidence String
  primarySource String
  levelPreference String @default("auto")
  assessmentMethod String @default("rules")
  assessmentReasoning String?
  syncStatus String @default("idle")
  syncError String?
  sourcesJson Json
  skillLevelId Int?
  computedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillLevel SkillLevel? @relation(fields: [skillLevelId], references: [id])

  @@index([tier])
  @@index([skillLevelId])
}

model LearningPath {
  id Int @id @default(autoincrement())
  targetSkillLevelId Int
  title String
  description String
  ownerUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skillLevel SkillLevel @relation(fields: [targetSkillLevelId], references: [id])
  owner User? @relation(fields: [ownerUserId], references: [id])
  pathModules PathModule[]
  learningProgresses UserLearningProgress[]
}

model PathModule {
  id Int @id @default(autoincrement())
  learningPathId Int
  topicId Int?
  moduleOrder Int @default(1)
  title String
  description String
  estimatedHours Int?
  learningObjectives Json?
  successCriteria Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  learningPath LearningPath @relation(fields: [learningPathId], references: [id])
  topic Topic? @relation(fields: [topicId], references: [id])
  moduleResources ModuleResource[]
  moduleProblems ModuleProblem[]
  learningProgresses UserLearningProgress[]
}

model ModuleResource {
  id Int @id @default(autoincrement())
  pathModuleId Int
  resourceType String
  title String
  description String?
  url String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pathModule PathModule @relation(fields: [pathModuleId], references: [id])
}

model ModuleProblem {
  id Int @id @default(autoincrement())
  pathModuleId Int
  externalProblemId String
  platform String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pathModule PathModule @relation(fields: [pathModuleId], references: [id])
  @@unique([pathModuleId, externalProblemId, platform])
}

model Topic {
  id Int @id @default(autoincrement())
  title String
  tags String
  rating String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pathModules PathModule[]
  snippets SolutionSnippet[]
}

model UserLearningProgress {
  id Int @id @default(autoincrement())
  userId String
  learningPathId Int
  currentModuleId Int?
  startedAt DateTime @default(now())
  completedAt DateTime?
  progressPercentage Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  learningPath LearningPath @relation(fields: [learningPathId], references: [id])
  currentModule PathModule? @relation(fields: [currentModuleId], references: [id])
}

model Achievement {
  id Int @id @default(autoincrement())
  name String
  description String
  achievementType String
  iconUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userAchievements UserAchievement[]
}

model UserAchievement {
  id Int @id @default(autoincrement())
  userId String
  achievementId Int
  progressData Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model Problem {
  id Int @id @default(autoincrement())
  externalProblemId String @unique
  contestId Int
  index String
  rating Int
  tags String
  title String?
  platform String @default("Codeforces")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContestStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model Contest {
  id String @id @default(cuid())
  title String
  description String?
  type String @default("VIRTUAL")
  status ContestStatus @default(DRAFT)
  difficulty String @default("MEDIUM")
  durationMinutes Int
  scheduledStartTime DateTime?
  freezeEnabled Boolean @default(true)
  freezeMinutes Int?
  rulesOfEngagement String @default("[]")
  virtualStartTime DateTime?
  createdByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation(fields: [createdByUserId], references: [id])
  problems ContestProblem[]
  participants ContestParticipant[]
  submissions ContestSubmission[]
}

model ContestProblem {
  id String @id @default(cuid())
  contestId String
  codePathProblemId String
  label String
  order Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  codePathProblem CodePathProblem @relation(fields: [codePathProblemId], references: [id])
  submissions ContestSubmission[]
  @@unique([contestId, label])
  @@unique([contestId, codePathProblemId])
}

model ContestParticipant {
  id String @id @default(cuid())
  contestId String
  userId String
  virtualStartTime DateTime?
  isVirtualReplay Boolean @default(false)
  penalty Int @default(0)
  solvedCount Int @default(0)
  rank Int?
  finished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contest Contest @relation(fields: [contestId], references: [id])
  user User @relation(fields: [userId], references: [id])
  submissions ContestSubmission[]
  @@unique([contestId, userId])
}

model ContestSubmission {
  id String @id @default(cuid())
  contestId String
  participantId String
  contestProblemId String
  codePathSubmissionId String?
  verdict String
  submissionTimeMinutes Int
  programmingLanguage String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contest Contest @relation(fields: [contestId], references: [id])
  participant ContestParticipant @relation(fields: [participantId], references: [id])
  contestProblem ContestProblem @relation(fields: [contestProblemId], references: [id])
  codePathSubmission CodePathSubmission? @relation(fields: [codePathSubmissionId], references: [id], onDelete: SetNull)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Coach {
  id String @id @default(cuid())
  userId String
  specialty String
  bio String?
  hourlyRate Decimal? @db.Decimal(10, 2)
  isAvailable Boolean @default(true)
  bookingLink String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  bookings Booking[]
  @@unique([userId])
}

model Booking {
  id String @id @default(cuid())
  coachId String
  menteeId String
  startTime DateTime
  endTime DateTime
  status BookingStatus @default(PENDING)
  meetingUrl String?
  notes String?
  calEventUid String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coach Coach @relation(fields: [coachId], references: [id])
  mentee User @relation("MenteeBookings", fields: [menteeId], references: [id])
  @@unique([coachId, startTime])
}

model SolutionSnippet {
  id String @id @default(cuid())
  userId String
  topicId Int?
  title String
  language String
  code String
  notes String?
  tags String?
  isPublic Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  topic Topic? @relation(fields: [topicId], references: [id])
}

// First-party CodePath Problem Set (separate from CF catalog `Problem`)
enum ProblemPublishStatus {
  DRAFT
  PUBLISHED
}

enum SubmissionVerdict {
  AC
  WA
  TLE
  RE
  CE
  JE
}

model CodePathProblem {
  id                String               @id @default(cuid())
  slug              String               @unique
  title             String
  statement         String
  inputDescription  String
  outputDescription String
  constraints       String?
  rating            Int                  // Codeforces-style rating (e.g. 800, 1200, 1600)
  tags              String               // JSON string array, same style as CF Problem.tags
  timeLimitMs       Int                  @default(2000)
  memoryLimitMb     Int                  @default(256)
  status            ProblemPublishStatus @default(DRAFT)
  createdByUserId   String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdBy         User                 @relation(fields: [createdByUserId], references: [id])
  testCases         ProblemTestCase[]
  submissions       CodePathSubmission[]
  contestProblems   ContestProblem[]

  @@index([status])
  @@index([rating])
}

model ProblemTestCase {
  id             String         @id @default(cuid())
  problemId      String
  input          String
  expectedOutput String
  isSample       Boolean        @default(false)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  problem        CodePathProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, sortOrder])
}

model CodePathSubmission {
  id          String            @id @default(cuid())
  problemId   String
  userId      String
  language    String
  code        String
  verdict     SubmissionVerdict
  passedCount Int               @default(0)
  totalCount  Int               @default(0)
  runtimeMs   Int?
  message     String?
  stderr      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  problem            CodePathProblem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contestSubmissions ContestSubmission[]

  @@index([userId, problemId, createdAt])
  @@index([problemId, createdAt])
}

model Insight {
  id        Int      @id @default(autoincrement())
  content   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}
